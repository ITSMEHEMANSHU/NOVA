# AI / Gemma 4 Model Configuration (Google GenAI / Gemini API)
GEMINI_API_KEY=
GEMINI_MODEL=gemma-4-31b-it

# GitHub REST API Token (Optional, increases rate limit from 60 to 5000 req/hr)
GITHUB_TOKEN=

# Cache / Layerbase Redis (Format: rediss://default:password@host.cloud.layerbase.dev:6379)
REDIS_URL=

# Trigger.dev Cloud Background Jobs
TRIGGER_SECRET_KEY=

# CORS Allowed Origins (JSON array string)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","https://oss-compass.vercel.app"]
